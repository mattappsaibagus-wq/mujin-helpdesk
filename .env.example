# ITSS PRO TOOL — configuration (copy to .env and adjust)
# The shared access code required to log in to the web console.
ITSS_PASS=change-me
# Signing key for session cookies. Use a long random value in production.
SECRET_KEY=$(python3 -c "import secrets; print(secrets.token_hex(32))")
# HTTP port for the web app (default 8000).
PORT=8000
# Set to "1" to enable Flask debug mode (development only).
DEBUG=0